# ========================================
# WhisperX バックエンド
# "docker_cli"（ローカルテスト推奨）| "remote" | "local" | "aws_batch" | "openai"
# ========================================
WHISPERX_BACKEND=docker_cli

# Docker CLI WhisperX（WHISPERX_BACKEND=docker_cli の場合 ← ローカルテスト推奨）
WHISPERX_DOCKER_IMAGE=ghcr.io/jim60105/whisperx:large-v3-ja
WHISPERX_BATCH_SIZE=8         # VRAM不足時は 4 に下げる（RTX 4080 は 8 で問題なし）
WHISPERX_COMPUTE_TYPE=float16 # VRAM節約時は int8
WHISPERX_TIMEOUT=3600         # タイムアウト秒数（100分動画でも余裕を持って1時間）
WHISPERX_CACHE_VOLUME=whisperx_hf_cache  # HuggingFace キャッシュ用 Docker ボリューム名。
                              # 初回実行時に pyannote/speaker-diarization-community-1 (~600MB) を自動DL。
                              # 以降はボリュームから読み込むため再DL不要。
HF_TOKEN=                     # 【必須】--diarize 未使用でもwhisperXが起動時にpyannote/speaker-diarization-community-1を無条件ロードするため常に必要。
                              # 1. HuggingFaceで利用規約に同意 → https://huggingface.co/pyannote/speaker-diarization-community-1
                              # 2. HFトークン発行 → https://huggingface.co/settings/tokens

# リモートサーバー（WHISPERX_BACKEND=remote の場合）
WHISPERX_SERVER_URL=http://127.0.0.1:9092
WHISPERX_API_KEY=dummy
WHISPERX_LANGUAGE=ja

# ローカル Python WhisperX（WHISPERX_BACKEND=local の場合）
WHISPERX_MODEL=large-v3
WHISPERX_DEVICE=cuda

# AWS Batch WhisperX（WHISPERX_BACKEND=aws_batch の場合）
AWS_BATCH_JOB_QUEUE=whisperx-gpu-queue
AWS_BATCH_JOB_DEFINITION=whisperx-transcription
AWS_S3_BUCKET=your-s3-bucket-name
AWS_REGION=ap-northeast-1
AWS_BATCH_POLL_INTERVAL=30    # ポーリング間隔（秒）

# ========================================
# タスク別 LLM
# provider: "openai" | "gemini"
# ========================================

# 日本語補正用（フィラー除去・誤字修正は軽量タスク → gpt-4.1-nano で十分）
# OpenAI: gpt-4.1-nano ($0.05/$0.20 per 1M in/out) ← 最安値
# Gemini:  gemini-2.5-flash-lite
CORRECTION_LLM_PROVIDER=openai
CORRECTION_OPENAI_MODEL=gpt-4.1-nano
CORRECTION_GEMINI_MODEL=gemini-2.5-flash-lite

# 英訳用（品質が核心 → gpt-5.4-mini: 最新世代で品質/コスト最適）
# OpenAI: gpt-5.4-mini ($0.75/$4.50 per 1M in/out) / 最高品質なら gpt-5.4 ($2.50/$15.00)
# Gemini:  gemini-2.5-flash
TRANSLATION_LLM_PROVIDER=openai
TRANSLATION_OPENAI_MODEL=gpt-5.4-mini
TRANSLATION_GEMINI_MODEL=gemini-2.5-flash

# 字幕分割・CPS修正用（tool calling ループ → gpt-4.1-nano: tool calling 得意・最安値）
# OpenAI: gpt-4.1-nano ($0.05/$0.20 per 1M in/out)
# Gemini:  gemini-2.5-flash-lite
SPLIT_LLM_PROVIDER=openai
SPLIT_OPENAI_MODEL=gpt-4.1-nano
SPLIT_GEMINI_MODEL=gemini-2.5-flash-lite

# ========================================
# API キー
# ========================================
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=               # Gemini 使用時

# ========================================
# Embedding バックエンド
# "openai" | "gemini"
# ========================================
EMBED_PROVIDER=openai
OPENAI_EMBED_MODEL=text-embedding-3-small
GEMINI_EMBED_MODEL=gemini-embedding-001          # GA安定版。multimodal対応preview: gemini-embedding-2-preview

# ========================================
# 制約設定ファイル
# プロジェクト管理者が constraints.yaml を編集・配布する運用を想定。
# メンバーはこのパスに配布されたファイルを置くだけでよい。
# ========================================
CONSTRAINTS_FILE=./constraints.yaml     # 省略時はスクリプトと同ディレクトリのファイルを使用

# ========================================
# その他
# ========================================
LLM_BATCH_SIZE=20
OUTPUT_DIR=./output
