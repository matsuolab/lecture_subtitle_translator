project_name                 = "matsuo-subtitle-pipeline"
environment                  = "dev"
aws_region                   = "ap-northeast-1"
managed_service_bearer_token = "replace-me"

private_subnet_ids = [
  "subnet-0d1bd97c8b33666b1",
  "subnet-06a3749e32f8af246",
  "subnet-0e78c1433062fb0cc"
]

batch_security_group_ids = [
  "sg-091e82d3fecf4c823"
]

# Production-path dev rollout: keep the same Batch/GPU route used in the target design.
batch_ec2_image_type      = "ECS_AL2023_NVIDIA"
batch_instance_types      = ["g4dn.xlarge"]
batch_ondemand_max_vcpus = 4
batch_gpu_spot_max_vcpus = 4
batch_gpu_ondemand_max_vcpus = 4
batch_vcpus              = 2
batch_memory             = 12288
batch_gpu_count          = 1
batch_root_volume_size_gb = 150
batch_custom_ami_id = "ami-0c1d51ced451f9ec0"
batch_worker_image_reference = "699092320766.dkr.ecr.ap-northeast-1.amazonaws.com/matsuo-subtitle-pipeline-dev-worker@sha256:c85ecf6a773d451bde7fa25e3fbb24f84c69d85636c79fe0371c2e3cf5c6d41d"
batch_image_pull_behavior = "prefer-cached"
whisperx_device          = "cuda"
whisperx_model           = "large-v3"
whisperx_language        = "ja"
whisperx_compute_type    = "float16"
whisperx_batch_size      = 4
batch_include_cpu_fallback = false

# custom AMI / digest fixed route examples:
# batch_custom_ami_id = "ami-0c1d51ced451f9ec0"
# batch_worker_image_reference = "699092320766.dkr.ecr.ap-northeast-1.amazonaws.com/matsuo-subtitle-pipeline-dev-worker@sha256:c85ecf6a773d451bde7fa25e3fbb24f84c69d85636c79fe0371c2e3cf5c6d41d"

# Keep Lambda outside the VPC in the first dev rollout so it can reach
# Secrets Manager, S3, and Batch APIs without adding NAT or VPC endpoints.
lambda_subnet_ids = []

lambda_security_group_ids = []

lambda_package_path = "../../../dist/lambda/backend.zip"

# コスト管理
budget_alert_email = "AIE-DXproject_3@weblab.t.u-tokyo.ac.jp"
monthly_budget_usd = 100

